# Copy to .env and fill in. Never commit .env.
AI_PROVIDER=anthropic            # anthropic | openai_compat | mock
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
# For Ollama / your own gateway instead:
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama3.1
FREE_DAILY=3
RATE_PER_MINUTE=30
APP_BUNDLE_ID=com.deancarson.tact
APP_APPLE_ID=                    # numeric App Store id, once the app exists in App Store Connect
APPLE_CERTS_DIR=./certs          # put AppleRootCA-G3.cer here (see README)
ALLOW_XCODE_TRANSACTIONS=1       # dev only: accept Xcode StoreKit test purchases. Set 0 in production
CLIENT_TOKEN=                    # optional: same value as TactClientToken in the iOS app
DB_PATH=./tact.db
PORT=5580
